{
  "description": "Minimal quality and pre-commit gates for workbench-ui.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/bash \"$(git rev-parse --show-toplevel)/.codex/hooks/project-gate.sh\" stop",
            "timeout": 180,
            "statusMessage": "Running changed-file tests, lint, and conditional security checks"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/bash \"$(git rev-parse --show-toplevel)/.codex/hooks/project-gate.sh\" pre-commit",
            "timeout": 300,
            "statusMessage": "Running final pre-commit validation"
          }
        ]
      }
    ]
  }
}
