@@ -7,6 +7,44 @@ import { webviewStyles } from './styles';
 
 const { resolveAssetSource } = Image;
 
+function isDestroyedDomWebView(error: unknown): boolean {
+  let current = error;
+  const visited = new Set<unknown>();
+  while (current && !visited.has(current)) {
+    visited.add(current);
+    const message = current instanceof Error ? current.message : String(current);
+    if (
+      message.includes('Unable to find the class expo.modules.webview.DomWebView view with tag')
+    ) {
+      return true;
+    }
+    current =
+      typeof current === 'object' && current !== null && 'cause' in current
+        ? (current as { cause?: unknown }).cause
+        : undefined;
+  }
+  return false;
+}
+
+function invokeNativeViewCommand(command: () => void): void {
+  try {
+    const pending = command() as unknown;
+    if (pending && typeof (pending as PromiseLike<unknown>).then === 'function') {
+      void Promise.resolve(pending).catch((error) => {
+        // React may dispose the native view between the ref read and the async Expo command.
+        // That teardown race is expected; keep reporting every other native command failure.
+        if (!isDestroyedDomWebView(error)) {
+          console.error('[expo-dom-webview] Native view command failed.', error);
+        }
+      });
+    }
+  } catch (error) {
+    if (!isDestroyedDomWebView(error)) {
+      throw error;
+    }
+  }
+}
+
 type NativeWebViewProps = Omit<DomWebViewProps, 'containerStyle' | 'injectedJavaScriptObject'> & {
   injectedJavaScriptObject: string;
 };
