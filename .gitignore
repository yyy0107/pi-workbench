# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/apps/web/.next/
/apps/web/public/vendor/material-icon-theme/
/apps/web/public/file-viewer/
/apps/desktop-renderer/.next/
/apps/desktop-renderer/out/
/apps/desktop-renderer/public/vendor/material-icon-theme/
/apps/desktop-renderer/public/file-viewer/

# production
/build
/.desktop-build
/.electron-build
/dist-electron
/release-assets
/apps/mobile/.expo/
/apps/mobile/android/
/apps/mobile/ios/
/apps/mobile/dist/
/apps/remote-control-relay/dist/

# misc
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*.pem
/.codex/
/.pi/
/.idea/
/.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/

# Turborepo
.turbo
