{
  "name": "@workbench/runtime-transport-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./runtime-transport-auth": {
      "types": "./src/runtime-transport-auth.ts",
      "import": "./src/runtime-transport-auth.ts",
      "default": "./src/runtime-transport-auth.ts"
    },
    "./workbench-http-server": {
      "types": "./src/workbench-http-server.ts",
      "import": "./src/workbench-http-server.ts",
      "default": "./src/workbench-http-server.ts"
    },
    "./fetch-request-handler": {
      "types": "./src/fetch-request-handler.ts",
      "import": "./src/fetch-request-handler.ts",
      "default": "./src/fetch-request-handler.ts"
    },
    "./runtime-sidecar-proxy": {
      "types": "./src/runtime-sidecar-proxy.ts",
      "import": "./src/runtime-sidecar-proxy.ts",
      "default": "./src/runtime-sidecar-proxy.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "node ../../../scripts/run-typescript-tests.mjs --package"
  },
  "dependencies": {
    "@workbench/runtime-contracts": "workspace:*",
    "@workbench/server-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "@workbench/runtime-transport-client": "workspace:*",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  }
}
