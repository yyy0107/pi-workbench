{
  "name": "@workbench/execution-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./node-executor": {
      "types": "./src/node-executor.ts",
      "import": "./src/node-executor.ts",
      "default": "./src/node-executor.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "import": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./engine": {
      "types": "./src/engine.ts",
      "import": "./src/engine.ts",
      "default": "./src/engine.ts"
    },
    "./repository": {
      "types": "./src/repository.ts",
      "import": "./src/repository.ts",
      "default": "./src/repository.ts"
    },
    "./service": {
      "types": "./src/service.ts",
      "import": "./src/service.ts",
      "default": "./src/service.ts"
    },
    "./terminal-command-executor": {
      "types": "./src/terminal-command-executor.ts",
      "import": "./src/terminal-command-executor.ts",
      "default": "./src/terminal-command-executor.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "node ../../../scripts/run-typescript-tests.mjs --package"
  },
  "dependencies": {
    "@workbench/execution-contracts": "workspace:*",
    "@workbench/server-core": "workspace:*",
    "@workbench/terminal-server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
