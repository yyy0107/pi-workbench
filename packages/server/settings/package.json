{
  "name": "@workbench/settings-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./file": {
      "types": "./src/file.ts",
      "import": "./src/file.ts",
      "default": "./src/file.ts"
    },
    "./service": {
      "types": "./src/service.ts",
      "import": "./src/service.ts",
      "default": "./src/service.ts"
    },
    "./rpc": {
      "types": "./src/rpc.ts",
      "import": "./src/rpc.ts",
      "default": "./src/rpc.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "node ../../../scripts/run-typescript-tests.mjs --package"
  },
  "dependencies": {
    "@workbench/agent-runtime-contracts": "workspace:*",
    "@workbench/contracts": "workspace:*",
    "@workbench/host-server": "workspace:*",
    "@workbench/server-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@workbench/host-contracts": "workspace:*",
    "typescript": "^7.0.2"
  }
}
