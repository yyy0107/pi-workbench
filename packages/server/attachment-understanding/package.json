{
  "name": "@workbench/attachment-understanding-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    },
    "./settings": {
      "types": "./src/settings-store.ts",
      "import": "./src/settings-store.ts",
      "default": "./src/settings-store.ts"
    },
    "./task": {
      "types": "./src/task.ts",
      "import": "./src/task.ts",
      "default": "./src/task.ts"
    },
    "./rpc": {
      "types": "./src/rpc.ts",
      "import": "./src/rpc.ts",
      "default": "./src/rpc.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "node ../../../scripts/run-typescript-tests.mjs --package"
  },
  "dependencies": {
    "@workbench/attachment-understanding-contracts": "workspace:*",
    "@workbench/host-server": "workspace:*",
    "@workbench/server-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@workbench/host-contracts": "workspace:*",
    "typescript": "^7.0.2"
  }
}
