    "@types/react-dom": "^19.2.4",
    "@workbench/pi-shared": "workspace:*",
    "@workbench/workspace-runtime": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
