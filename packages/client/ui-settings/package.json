{
  "name": "@workbench/ui-settings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./request": "./src/settings-main-view.ts",
    "./i18n": "./src/i18n/index.ts",
    "./surface": "./src/settings-main-view-content.tsx",
    "./sidebar": "./src/settings-sidebar.tsx",
    "./sidebar-rail": "./src/settings-sidebar-rail.tsx",
    "./background-image": "./src/background-image-store.ts",
    "./background": "./src/appearance-background.tsx",
    "./styles.css": "./src/appearance-background.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "node ../../../scripts/run-typescript-tests.mjs --package"
  },
  "dependencies": {
    "@workbench/appearance": "workspace:*",
    "@workbench/code-highlighting": "workspace:*",
    "@workbench/core-contracts": "workspace:*",
    "@workbench/extension-host": "workspace:*",
    "@workbench/extension-sdk": "workspace:*",
    "@workbench/i18n": "workspace:*",
    "@workbench/settings-runtime": "workspace:*",
    "@workbench/shell-context": "workspace:*",
    "@workbench/ui": "workspace:*",
    "lucide-react": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@workbench/ui-testkit": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
