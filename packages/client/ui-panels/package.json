{
  "name": "@workbench/ui-panels",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "import": "./src/i18n/index.ts",
      "default": "./src/i18n/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "node ../../../scripts/run-typescript-tests.mjs --package"
  },
  "dependencies": {
    "@workbench/extension-host": "workspace:*",
    "@workbench/extension-sdk": "workspace:*",
    "@workbench/i18n": "workspace:*",
    "@workbench/ui": "workspace:*",
    "lucide-react": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
