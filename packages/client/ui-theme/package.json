{
  "name": "@workbench/ui-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./appearance": "./src/appearance-index.ts",
    "./background": "./src/appearance-background.tsx",
    "./background-image": "./src/background-image-store.ts",
    "./color-picker": "./src/color-picker.tsx",
    "./color-picker.css": "./src/color-picker.css",
    "./styles.css": "./src/appearance-background.css",
    "./i18n": "./src/i18n/index.ts",
    "./appearance-extension": "./src/appearance-extension.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "node ../../../scripts/run-typescript-tests.mjs --package"
  },
  "dependencies": {
    "@workbench/appearance": "workspace:*",
    "@workbench/code-highlighting": "workspace:*",
    "@workbench/extension-sdk": "workspace:*",
    "@workbench/i18n": "workspace:*",
    "@workbench/settings-runtime": "workspace:*",
    "@workbench/shell-context": "workspace:*",
    "@workbench/ui": "workspace:*",
    "@workbench/ui-settings": "workspace:*",
    "lucide-react": "^1.29.0",
    "react-colorful": "^5.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
