{
  "name": "@workbench/code-highlighting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/shiki-highlighter.ts",
    "./header": "./src/codex-code-header.tsx",
    "./i18n": "./src/i18n/index.ts",
    "./styles.css": "./src/styles.css",
    "./editor.css": "./src/workbench-code-editor.css",
    "./diff.css": "./src/diff/reviewable-diff.css",
    "./code-block.css": "./src/code-block.css"
