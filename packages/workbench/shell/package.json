{
  "name": "@workbench/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./application": {
      "types": "./src/application.tsx",
      "import": "./src/application.tsx",
      "default": "./src/application.tsx"
    },
    "./browser-session-persistence": {
      "types": "./src/browser-session-persistence.ts",
      "import": "./src/browser-session-persistence.ts",
      "default": "./src/browser-session-persistence.ts"
    },
    "./extensions": {
      "types": "./src/extensions/index.ts",
      "import": "./src/extensions/index.ts",
      "default": "./src/extensions/index.ts"
    },
    "./hosts/statusbar": {
      "types": "./src/hosts/statusbar.tsx",
      "import": "./src/hosts/statusbar.tsx",
      "default": "./src/hosts/statusbar.tsx"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "import": "./src/i18n/index.ts",
      "default": "./src/i18n/index.ts"
    },
    "./i18n/runtime": {
      "types": "./src/i18n/public-runtime.ts",
      "import": "./src/i18n/public-runtime.ts",
      "default": "./src/i18n/public-runtime.ts"
    },
    "./panels": {
      "types": "./src/panels/index.ts",
      "import": "./src/panels/index.ts",
      "default": "./src/panels/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./workbench": {
      "types": "./src/workbench.ts",
      "import": "./src/workbench.ts",
      "default": "./src/workbench.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "node ../../../scripts/run-typescript-tests.mjs --package"
  },
  "dependencies": {
