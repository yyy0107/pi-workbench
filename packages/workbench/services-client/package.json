{
  "name": "@workbench/services-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./settings": {
      "types": "./src/settings.ts",
      "import": "./src/settings.ts",
      "default": "./src/settings.ts"
    },
    "./automation": {
      "types": "./src/automation.ts",
      "import": "./src/automation.ts",
      "default": "./src/automation.ts"
    },
    "./host": {
      "types": "./src/host.ts",
      "import": "./src/host.ts",
      "default": "./src/host.ts"
    },
    "./workspace": {
      "types": "./src/workspace.ts",
      "import": "./src/workspace.ts",
      "default": "./src/workspace.ts"
    },
    "./attachment-understanding": {
      "types": "./src/attachment-understanding.ts",
      "import": "./src/attachment-understanding.ts",
      "default": "./src/attachment-understanding.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "import": "./src/errors.ts",
      "default": "./src/errors.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "node ../../../scripts/run-typescript-tests.mjs --package"
  },
  "dependencies": {
    "@workbench/agent-runtime-client": "workspace:*",
    "@workbench/agent-runtime-contracts": "workspace:*",
    "@workbench/attachment-understanding-contracts": "workspace:*",
    "@workbench/automation-contracts": "workspace:*",
    "@workbench/host-client": "workspace:*",
    "@workbench/host-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  }
}
