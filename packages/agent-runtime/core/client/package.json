{
  "name": "@workbench/agent-runtime-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./adapter": {
      "types": "./src/agent-runtime-adapter.ts",
      "import": "./src/agent-runtime-adapter.ts",
      "default": "./src/agent-runtime-adapter.ts"
    },
    "./context": {
      "types": "./src/agent-runtime-context.tsx",
      "import": "./src/agent-runtime-context.tsx",
      "default": "./src/agent-runtime-context.tsx"
    },
    "./extras": {
      "types": "./src/agent-runtime-extras.ts",
      "import": "./src/agent-runtime-extras.ts",
      "default": "./src/agent-runtime-extras.ts"
    },
    "./installation": {
      "types": "./src/agent-runtime-installation.tsx",
      "import": "./src/agent-runtime-installation.tsx",
      "default": "./src/agent-runtime-installation.tsx"
    },
    "./message-statistics": {
      "types": "./src/message-statistics.ts",
      "import": "./src/message-statistics.ts",
      "default": "./src/message-statistics.ts"
    },
    "./prompt-feedback": {
      "types": "./src/prompt-feedback.ts",
      "import": "./src/prompt-feedback.ts",
      "default": "./src/prompt-feedback.ts"
    },
    "./workspaces": {
      "types": "./src/workspaces.tsx",
      "import": "./src/workspaces.tsx",
      "default": "./src/workspaces.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "node ../../../../scripts/run-typescript-tests.mjs --package"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.16",
    "@workbench/agent-runtime-contracts": "workspace:*",
    "@workbench/automation-contracts": "workspace:*",
    "@workbench/execution-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  }
}
