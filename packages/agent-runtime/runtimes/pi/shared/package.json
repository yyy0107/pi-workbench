      "default": "./src/commands.ts"
    },
    "./messages": {
      "types": "./src/messages.ts",
      "import": "./src/messages.ts",
      "default": "./src/messages.ts"
    },
    "./models": {
      "types": "./src/models.ts",
      "import": "./src/models.ts",
      "default": "./src/models.ts"
    },
    "./sessions": {
      "types": "./src/sessions.ts",
      "import": "./src/sessions.ts",
      "default": "./src/sessions.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "node ../../../../../scripts/run-typescript-tests.mjs --package"
