{
  "name": "@workbench/agent-runtime-pi-shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./descriptor": {
      "types": "./src/descriptor.ts",
      "import": "./src/descriptor.ts",
      "default": "./src/descriptor.ts"
    },
    "./commands": {
      "types": "./src/commands.ts",
