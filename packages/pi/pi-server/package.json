{
  "name": "@workbench/pi-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./installation": {
      "types": "./src/public/installation.ts",
      "import": "./src/public/installation.ts",
      "default": "./src/public/installation.ts"
    },
    "./http": {
      "types": "./src/public/http.ts",
      "import": "./src/public/http.ts",
      "default": "./src/public/http.ts"
    },
    "./websocket": {
      "types": "./src/public/websocket.ts",
      "import": "./src/public/websocket.ts",
      "default": "./src/public/websocket.ts"
    },
    "./legacy": {
      "types": "./src/public/legacy.ts",
      "import": "./src/public/legacy.ts",
      "default": "./src/public/legacy.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "node ../../../scripts/run-typescript-tests.mjs --package",
    "bench:history": "node --no-warnings=ExperimentalWarning --import ../../../scripts/register-typescript-test-loader.mjs tests/benchmarks/session-history.benchmark.ts",
    "diagnose:stream": "node --no-warnings=ExperimentalWarning --import ../../../scripts/register-typescript-test-loader.mjs tests/benchmarks/opencode-stream-diagnostic.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@workbench/agent-runtime-contracts": "workspace:*",
    "@workbench/agent-runtime-server": "workspace:*",
    "@workbench/automation-contracts": "workspace:*",
    "@workbench/browser-contracts": "workspace:*",
    "@workbench/core-contracts": "workspace:*",
    "@workbench/host-server": "workspace:*",
    "@workbench/local-host-server": "workspace:*",
    "@workbench/pi-browser": "workspace:*",
    "@workbench/pi-model-server": "workspace:*",
    "@workbench/pi-protocol": "workspace:*",
    "@workbench/pi-resources-server": "workspace:*",
    "@workbench/pi-server-ports": "workspace:*",
    "@workbench/pi-session-server": "workspace:*",
    "@workbench/pi-shared": "workspace:*",
    "@workbench/pi-tools": "workspace:*",
    "@workbench/server-core": "workspace:*",
    "@workbench/workspace-server": "workspace:*",
    "mime": "4.1.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@workbench/agent-runtime-testkit": "workspace:*",
    "@workbench/settings-server": "workspace:*",
    "typescript": "^7.0.2"
  }
}
