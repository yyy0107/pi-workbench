  "compatibilityExceptions": [
    {
      "id": "duplicate-recognized-key",
      "parityGate": false,
      "bytes": {
        "kind": "utf8",
        "value": "{\"type\":\"ready\",\"controlVersion\":2,\"controlVersion\":1,\"hostProtocolVersion\":1,\"instanceId\":\"runtime-fixture\",\"pid\":4242,\"httpOrigin\":\"http://127.0.0.1:43127\"}\n"
      },
      "typescriptCurrentBehavior": "JSON.parse retains the final value before exact post-parse key validation.",
      "rustRequirement": "A strict serde DTO rejects duplicate recognized fields."
    },
    {
      "id": "lone-utf16-surrogate-escape",
      "parityGate": false,
      "bytes": {
        "kind": "utf8",
        "value": "{\"type\":\"ready\",\"controlVersion\":1,\"hostProtocolVersion\":1,\"instanceId\":\"\\ud800\",\"pid\":4242,\"httpOrigin\":\"http://127.0.0.1:43127\"}\n"
      },
      "typescriptCurrentBehavior": "JSON.parse produces one unpaired UTF-16 code unit that the current string guard accepts.",
      "rustRequirement": "serde_json String decoding rejects an unpaired surrogate escape."
    }
  ]
