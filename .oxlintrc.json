{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import"],
  "rules": {
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": ["packages/pi/pi-contributions/src/**/*"],
      "excludeFiles": ["**/*.test.*", "**/*.spec.*", "**/*.bench.*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/**", "next", "next/**"],
                "message": "Pi contributions must stay independent from the app and Next.js."
              },
              {
                "group": [
                  "@workbench/extension-host/internal",
                  "@workbench/extension-sdk/internal",
                  "@workbench/pi-server",
                  "@workbench/pi-server/**",
                  "@earendil-works/pi*"
                ],
                "message": "Use the public Extension Platform and Pi client seams."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/client/shell/src/**/*"],
      "excludeFiles": ["**/*.test.*", "**/*.spec.*", "**/*.bench.*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@workbench/extension-host",
                "allowImportNames": [
                  "useCommandService",
                  "useComposerCommandRegistry",
                  "useExtensionErrorReporter",
                  "useMainViewService",
                  "usePanelRegistry",
                  "usePanelService",
                  "useSettingsRegistry",
                  "useSidebarSectionRegistry"
                ],
                "message": "Shell may consume only the finite public host hooks."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@/**",
                  "@earendil-works/pi*",
                  "@workbench/pi*",
                  "i18next",
                  "i18next/**",
                  "react-i18next",
                  "react-i18next/**",
                  "next-intl",
                  "next-intl/**",
                  "next",
                  "next/**",
                  "node:*",
                  "node-pty",
                  "tree-sitter",
                  "tree-sitter-bash",
                  "electron",
                  "electron/**",
                  "@electron/**"
                ],
                "message": "Shell must remain product-, framework-, and host-neutral."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**/*", "apps/desktop-renderer/src/**/*"],
      "excludeFiles": ["**/*.test.*", "**/*.spec.*", "**/*.bench.*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@workbench/pi-client",
                  "@workbench/pi-client/**",
                  "@workbench/pi-protocol",
                  "@workbench/pi-protocol/**",
                  "@workbench/pi-shared",
                  "@workbench/pi-shared/**"
                ],
                "message": "Install Pi once at the application composition root."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/desktop-renderer/src/desktop/desktop-workbench.tsx",
        "apps/web/src/workbench/providers/installed-agent-runtime.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@workbench/pi-protocol",
              "@workbench/pi-protocol/**",
              "@workbench/pi-shared",
              "@workbench/pi-shared/**"
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/server/runtime-connected-web-host.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@workbench/pi-client",
                  "@workbench/pi-client/**",
                  "@workbench/pi-contributions",
                  "@workbench/pi-contributions/**",
                  "@workbench/pi-server",
                  "@workbench/pi-server/**",
                  "@workbench/pi-shared",
                  "@workbench/pi-shared/**"
                ],
                "message": "The Runtime proxy composition may read only Pi's stable stream paths."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/workbench/providers/installed-workbench-settings.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@workbench/pi-client/workbench-settings",
                "allowImportNames": ["createPiWorkbenchSettingsClient"],
                "allowTypeImports": true,
                "message": "Install only the settings client at this composition root."
              }
            ],
            "patterns": [
              "@workbench/pi-protocol",
              "@workbench/pi-protocol/**",
              "@workbench/pi-shared",
              "@workbench/pi-shared/**"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/client/ui-sidebar/{src,lib}/**/*",
        "packages/client/ui-panels/{src,lib}/**/*",
        "packages/client/ui-layout/{src,lib}/**/*"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@workbench/extension-host",
                "allowImportNames": [
                  "useCommandService",
                  "useComposerCommandRegistry",
                  "useExtensionErrorReporter",
                  "useMainViewService",
                  "usePanelRegistry",
                  "usePanelService",
                  "useSettingsRegistry",
                  "useSidebarSectionRegistry"
                ],
                "message": "Shell may consume only the finite public host hooks."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@/**",
                  "@earendil-works/pi*",
                  "@workbench/pi*",
                  "i18next",
                  "i18next/**",
                  "react-i18next",
                  "react-i18next/**",
                  "next-intl",
                  "next-intl/**",
                  "next",
                  "next/**",
                  "node:*",
                  "node-pty",
                  "tree-sitter",
                  "tree-sitter-bash",
                  "electron",
                  "electron/**",
                  "@electron/**"
                ],
                "message": "Shell must remain product-, framework-, and host-neutral."
              },
              {
                "group": [
                  "@workbench/shell",
                  "@workbench/shell/**",
                  "@workbench/pi-product",
                  "@workbench/pi-product/**"
                ],
                "message": "Client component capabilities must not depend on application composition."
              }
            ]
          }
        ]
      },
      "excludeFiles": ["**/*.test.*", "**/*.spec.*", "**/*.bench.*"]
    }
  ]
}
