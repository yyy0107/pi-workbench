{
  "name": "@workbench/desktop-renderer",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "scripts": {
    "icons:sync": "node scripts/sync-material-icon-theme.mjs",
    "file-viewer:sync": "node scripts/sync-file-viewer-assets.mjs",
    "assets:sync": "pnpm icons:sync && pnpm file-viewer:sync",
    "predev": "pnpm assets:sync",
    "dev": "next dev",
    "prebuild": "pnpm assets:sync",
    "build": "next build",
    "postbuild": "tsx scripts/build-desktop-renderer-artifact.ts",
    "test": "node ../../scripts/run-typescript-tests.mjs --package",
    "typecheck": "next typegen && tsc --noEmit --incremental false -p tsconfig.json"
  },
  "dependencies": {
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@workbench/desktop-contracts": "workspace:*",
    "@workbench/extension-host": "workspace:*",
    "@workbench/extension-sdk": "workspace:*",
    "@workbench/host-client": "workspace:*",
    "@workbench/host-contracts": "workspace:*",
    "@workbench/pi-product": "workspace:*",
    "@workbench/shell": "workspace:*",
    "katex": "^0.16.47",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "@workbench/agent-runtime-client": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@workbench/host-artifact-policy": "workspace:*",
    "file-viewer-copy-assets": "2.3.0",
    "material-icon-theme": "^5.37.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
