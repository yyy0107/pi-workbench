{
  "name": "@workbench/desktop-tauri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run stage:renderer && pnpm run stage:sidecar",
    "dev": "pnpm run stage:sidecar && tauri dev",
    "smoke:packaged": "tsx scripts/linux-packaged-product-smoke.ts",
    "smoke:packaged:hard-death": "tsx scripts/linux-packaged-product-smoke.ts --hard-death",
    "stage:renderer": "tsx scripts/stage-desktop-renderer-artifact.ts",
    "stage:sidecar": "tsx scripts/stage-tauri-sidecar-envelope.ts",
    "tauri:build": "pnpm run stage:sidecar && tauri build",
    "tauri:build:deb": "pnpm run stage:sidecar && tauri build --bundles deb",
    "test": "node ../../scripts/run-typescript-tests.mjs --package",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json"
  },
  "dependencies": {
    "@workbench/host-contracts": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^26.2.0",
    "@workbench/host-artifact-policy": "workspace:*",
    "@workbench/host-server": "workspace:*",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
