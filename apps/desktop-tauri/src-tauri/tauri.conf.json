{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Workbench",
  "version": "0.1.0",
  "identifier": "com.piworkbench.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm run stage:renderer",
      "wait": true
    },
    "beforeBuildCommand": "pnpm run stage:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Pi Workbench",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["main-runtime-control"],
      "dangerousDisableAssetCspModification": false,
      "csp": "default-src 'self'; base-uri 'none'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; font-src 'self'; form-action 'none'; frame-ancestors 'none'; frame-src 'none'; img-src 'self' blob: data:; media-src 'self' blob: data:; object-src 'none'; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/workbench-runtime-node"],
    "resources": {
      "resources/runtime/": "runtime/"
    }
  }
}
