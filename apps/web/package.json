{
  "name": "@workbench/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "icons:sync": "node scripts/sync-material-icon-theme.mjs",
    "file-viewer:sync": "node scripts/sync-file-viewer-assets.mjs",
    "predev": "pnpm icons:sync && pnpm file-viewer:sync",
    "dev": "node ../../scripts/web-runtime-watch.mjs",
    "dev:once": "node ../../scripts/web-runtime-orchestrator.mjs --development",
    "prebuild": "pnpm icons:sync && pnpm file-viewer:sync",
    "build": "next build",
    "postbuild": "tsx scripts/build-web-artifact.ts",
    "smoke:standalone": "node scripts/web-standalone-smoke.cjs",
    "start": "node ../../scripts/web-runtime-orchestrator.mjs --production",
    "test": "node ../../scripts/run-typescript-tests.mjs --package",
    "typecheck": "next typegen && tsc --noEmit --incremental false -p tsconfig.json"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.16",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@workbench/agent-runtime-client": "workspace:*",
    "@workbench/agent-runtime-contracts": "workspace:*",
    "@workbench/agent-runtime-pi-client": "workspace:*",
    "@workbench/agent-runtime-pi-contributions": "workspace:*",
    "@workbench/agent-runtime-pi-protocol": "workspace:*",
    "@workbench/desktop-contracts": "workspace:*",
    "@workbench/extension-host": "workspace:*",
    "@workbench/extension-sdk": "workspace:*",
    "@workbench/host-artifact-policy": "workspace:*",
    "@workbench/host-client": "workspace:*",
    "@workbench/host-contracts": "workspace:*",
    "@workbench/host-server": "workspace:*",
    "@workbench/settings-server": "workspace:*",
    "@workbench/shell": "workspace:*",
    "@workbench/terminal-contracts": "workspace:*",
    "katex": "^0.16.47",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.5.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@workbench/agent-runtime-pi-shared": "workspace:*",
    "esbuild": "^0.28.2",
    "file-viewer-copy-assets": "2.3.0",
    "material-icon-theme": "^5.37.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
