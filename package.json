{
  "name": "workbench-ui",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "icons:sync": "pnpm --filter @workbench/web run icons:sync",
    "file-viewer:sync": "pnpm --filter @workbench/web run file-viewer:sync",
    "predev": "node apps/web/scripts/sync-assets.mjs",
    "dev": "node scripts/web-runtime-dev.mjs",
    "dev:once": "node scripts/web-runtime-orchestrator.mjs --development",
    "electron:dev": "pnpm --filter @workbench/desktop-electron build && node scripts/electron-dev-orchestrator.mjs",
    "electron:dev:connect": "node scripts/electron-dev-orchestrator.mjs --connect-existing",
    "electron:pack": "pnpm build && pnpm --filter @workbench/desktop-electron run pack",
    "electron:pack:artifact": "pnpm build && pnpm --filter @workbench/desktop-electron run pack:artifact",
    "electron:dist": "pnpm build && pnpm --filter @workbench/desktop-electron run dist",
    "electron:dist:artifact": "pnpm build && pnpm --filter @workbench/desktop-electron run dist:artifact",
    "electron:budget": "pnpm --filter @workbench/desktop-electron run budget",
    "bench:pi-history": "pnpm --filter @workbench/agent-runtime-pi-server run bench:history",
    "prebuild": "node scripts/prepare-workbench-build.cjs",
    "build": "pnpm --filter @workbench/runtime-node build && pnpm --filter @workbench/web build && pnpm --filter @workbench/desktop-electron run build",
    "start": "node scripts/web-runtime-orchestrator.mjs --production",
    "test": "pnpm test:root && pnpm test:apps && pnpm test:packages",
    "test:root": "node scripts/run-typescript-tests.mjs",
    "test:apps": "pnpm --recursive --filter './apps/**' --if-present run test",
    "test:packages": "pnpm --recursive --filter './packages/**' --if-present run test",
    "typecheck": "pnpm typecheck:apps && pnpm typecheck:packages",
    "typecheck:apps": "pnpm --recursive --filter './apps/**' --if-present run typecheck",
    "typecheck:packages": "pnpm --recursive --filter './packages/**' --if-present run typecheck",
    "check:workspace-dependencies": "node scripts/check-workspace-dependencies.mjs && node scripts/check-runtime-host-ownership.mjs",
    "check": "pnpm lint && pnpm check:workspace-dependencies && pnpm typecheck && pnpm test",
    "lint": "oxlint --ignore-pattern '**/node_modules/**' && oxfmt --check",
    "lint:fix": "oxlint --ignore-pattern '**/node_modules/**' --fix && oxfmt",
    "format": "oxfmt --check",
    "format:fix": "oxfmt"
  },
  "devDependencies": {
    "@workbench/agent-runtime-pi-contributions": "workspace:*",
    "@workbench/extension-sdk": "workspace:*",
    "@workbench/host-contracts": "workspace:*",
    "@workbench/host-server": "workspace:*",
    "@workbench/shell": "workspace:*",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsx": "^4.23.12"
  },
  "packageManager": "pnpm@11.22.0"
}
