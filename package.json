{
  "name": "workbench-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "icons:sync": "node scripts/sync-material-icon-theme.mjs",
    "file-viewer:sync": "node scripts/sync-file-viewer-assets.mjs",
    "predev": "pnpm icons:sync && pnpm file-viewer:sync",
    "dev": "node scripts/dev-server.mjs",
    "electron:dev": "electron .",
    "electron:pack": "pnpm build && node electron/build-package.cjs --dir",
    "electron:dist": "pnpm build && node electron/build-package.cjs",
    "electron:budget": "node electron/check-runtime-budget.cjs",
    "bench:pi-history": "node --no-warnings=ExperimentalWarning --import ./scripts/register-typescript-test-loader.mjs runtime/pi/server/sessions/session-history.benchmark.ts",
    "prebuild": "pnpm icons:sync && pnpm file-viewer:sync",
    "build": "next build && node electron/build-desktop-server.cjs",
    "start": "node electron/desktop-server-launcher.cjs .desktop-build/server.mjs",
    "test": "node --no-warnings=ExperimentalWarning --import ./scripts/register-typescript-test-loader.mjs --test",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt --check",
    "format:fix": "oxfmt"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.16",
    "@assistant-ui/react-generative-ui": "^0.0.15",
    "@assistant-ui/react-lexical": "0.2.9",
    "@assistant-ui/react-streamdown": "^0.3.11",
    "@base-ui/react": "^1.7.0",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@file-viewer/core": "2.3.0",
    "@file-viewer/preset-lite": "2.3.0",
    "@file-viewer/preset-office": "2.3.0",
    "@file-viewer/react": "2.3.0",
    "@lexical/code-core": "0.49.0",
    "@lexical/link": "0.49.0",
    "@lexical/list": "0.49.0",
    "@lexical/markdown": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lexical/rich-text": "0.49.0",
    "@shikijs/langs": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@tanstack/react-virtual": "3.14.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.5",
    "assistant-stream": "0.3.37",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.10.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "katex": "^0.16.47",
    "lexical": "0.49.0",
    "lucide-react": "^1.29.0",
    "material-icon-theme": "^5.37.0",
    "mime": "4.1.0",
    "next": "^16.3.0",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.2.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "^0.3.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-bash": "^0.25.1",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "typebox": "1.3.7",
    "ws": "^8.21.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vercel/nft": "^1.11.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "file-viewer-copy-assets": "2.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "shiki": "3.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.piworkbench.desktop",
    "productName": "Pi Workbench",
    "asar": false,
    "npmRebuild": false,
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "directories": {
      "app": ".electron-build/app",
      "output": "dist-electron"
    },
    "files": [
      "package.json",
      "electron/hardware-acceleration-preference.cjs",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/server-probe.cjs",
      "electron/server-process-lifecycle.cjs",
      "electron/server-startup-handshake.cjs",
      "desktop-runtime/**/*",
      "public/icon.png",
      "!node_modules/**/*"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "public/icon.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ]
    }
  },
  "desktopName": "com.piworkbench.PiWorkbench.desktop",
  "productName": "Pi Workbench"
}
